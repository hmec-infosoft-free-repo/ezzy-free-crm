{
    "folders": [
        {
            "name": "Ezzy Free CRM",
            "path": "."
        }
    ],
    "settings": {
        "terminal.integrated.defaultProfile.windows": "PowerShell",
        "terminal.integrated.cwd": "${workspaceFolder}",
        "files.exclude": {
            "**/.git": false,
            "**/.svn": true,
            "**/.hg": true,
            "**/CVS": true,
            "**/.DS_Store": true,
            "**/Thumbs.db": true
        },
        "search.exclude": {
            "**/node_modules": true,
            "**/local-data-backup": true
        }
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Start Ezzy Free CRM Server",
                "type": "shell",
                "command": "node server.js",
                "isBackground": true,
                "problemMatcher": {
                    "pattern": {
                        "regexp": "^.*$",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    },
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": ".*",
                        "endsPattern": "Ezzy Free CRM server running.*"
                    }
                },
                "presentation": {
                    "reveal": "always",
                    "panel": "new"
                },
                "group": {
                    "kind": "build",
                    "isDefault": true
                }
            },
            {
                "label": "Run Smart Tagging",
                "type": "shell",
                "command": "node smart-tagging.js",
                "presentation": {
                    "reveal": "always",
                    "panel": "shared"
                },
                "problemMatcher": []
            },
            {
                "label": "Update Leads Quality",
                "type": "shell",
                "command": "node update-leads-quality.js",
                "presentation": {
                    "reveal": "always",
                    "panel": "shared"
                },
                "problemMatcher": []
            },
            {
                "label": "Format Leads DB",
                "type": "shell",
                "command": "node format-leads.js",
                "presentation": {
                    "reveal": "always",
                    "panel": "shared"
                },
                "problemMatcher": []
            },
            {
                "label": "Install Dependencies (npm install)",
                "type": "shell",
                "command": "npm install",
                "presentation": {
                    "reveal": "always",
                    "panel": "shared"
                },
                "problemMatcher": []
            }
        ]
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "type": "msedge",
                "request": "launch",
                "name": "Launch Edge (Ezzy Free CRM - Port 7900)",
                "url": "http://localhost:7900",
                "webRoot": "${workspaceFolder}/public",
                "preLaunchTask": "Start Ezzy Free CRM Server"
            },
            {
                "type": "chrome",
                "request": "launch",
                "name": "Launch Chrome (Ezzy Free CRM - Port 7900)",
                "url": "http://localhost:7900",
                "webRoot": "${workspaceFolder}/public",
                "preLaunchTask": "Start Ezzy Free CRM Server"
            },
            {
                "type": "node",
                "request": "launch",
                "name": "Debug Server (server.js)",
                "program": "${workspaceFolder}/server.js",
                "restart": true,
                "console": "integratedTerminal"
            }
        ]
    }
}
